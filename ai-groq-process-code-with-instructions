#!/usr/bin/env bash
# Process the code with the instruction in it for AI processing.
# Usage in Helix: | ai-groq-process-code "your code"

GROQ_MODEL=$(cat "$HOME/secrets/groq-modele" | tr -d '[:space:]')

# Read stdin (the selected code)
stdin_content=$(cat)

user_content="$*

Code:
\`\`\`
In the code below, find the AI instructions and process the code as asked.

- Return the code processed without adding any comments or explanation on the operation itself.
- Return unmodified lines exactly like they were.
- Preserve any formatting.
- Keep the same style.
- Keep the line length at 120 characters maximum.
- When creating new variables, use explicit names.
- Be brief. Keep it simple while being complete and explicit.
- Don't mark at the beginning or ending of the code to mark the response as code.

$stdin_content
\`\`\`"

# Call Groq API
response=$(curl -s http://groq.proxy:4140/openai/v1/chat/completions \
  -H "Content-Type: application/json" \
  -d "{
    \"model\": \"$GROQ_MODEL\",
    \"messages\": [{\"role\": \"user\", \"content\": $(echo "$user_content" | jq -Rs .)}],
    \"temperature\": 0.3,
    \"max_tokens\": 2048
  }")

explanation=$(echo "$response" | jq -r '.choices[0].message.content // "Error: No response"')

# Output: AI response
echo "$explanation"
