#!/usr/bin/env bash
# Ask a question to the AI with optional screen selection as context.
# Usage: Select text on screen, then run this script.
# A dialog will appear to type the question; the answer is shown in a text box.

GROQ_MODEL=$(cat "$HOME/secrets/groq-modele" | tr -d '[:space:]')

# Get selected text from primary selection (Wayland or X11)
if command -v wl-paste &>/dev/null; then
  context=$(wl-paste --primary --no-newline 2>/dev/null)
elif command -v xclip &>/dev/null; then
  context=$(xclip -selection primary -o 2>/dev/null)
elif command -v xsel &>/dev/null; then
  context=$(xsel --primary --output 2>/dev/null)
fi

# Prompt for question with full context displayed above the input field
if [ -n "$context" ]; then
  result=$(yad --form \
    --title="Ask the AI" \
    --width=650 --height=400 \
    --field="Context:TXT" "$context" \
    --field="Question" \
    --focus-field=2 \
    --button="Cancel":1 \
    --button="Send":0)
  # yad --form outputs fields separated by |
  question=$(echo "$result" | cut -d'|' -f2)
else
  question=$(yad --entry \
    --title="Ask the AI" \
    --text="Question" \
    --width=600 \
    --button="Cancel":1 \
    --button="Send":0)
fi

# Exit silently if the user cancelled
[ -z "$question" ] && exit 0

# Build the message content
if [ -n "$context" ]; then
  user_content="$question

Context:
\`\`\`
$context
\`\`\`"
else
  user_content="$question"
fi

# Call Groq API
response=$(curl -s http://groq.proxy:4140/openai/v1/chat/completions \
  -H "Content-Type: application/json" \
  -d "{
    \"model\": \"$GROQ_MODEL\",
    \"messages\": [{\"role\": \"user\", \"content\": $(echo "$user_content" | jq -Rs .)}],
    \"temperature\": 0.3,
    \"max_tokens\": 2048
  }")

answer=$(echo "$response" | jq -r '.choices[0].message.content // "Error: no response from API"')

# Display the answer in a scrollable, wrapping text box
echo "$answer" | yad \
  --text-info \
  --wrap \
  --title="AI Answer" \
  --width=700 \
  --height=500 \
  --fontname="monospace 11" \
  --escape-ok \
  --button="Close":0
